#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";        
        default_layer {
            display-name="o==[]::::::::::::::::>";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | DEL   |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   \   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   PREV |  |  NEXT |  N   |  M    |  ,    |  .   |   /   | SHIFT |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT  |  =    | CTRL  |
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3      &kp N4      &kp N5                           &kp N6    &kp N7      &kp N8     &kp N9     &kp N0      &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E       &kp R       &kp T                            &kp Y     &kp U       &kp I      &kp O      &kp P       &kp DEL
&kp CAPS   &kp A     &kp S     &kp D       &kp F       &kp G                            &kp H     &kp J       &kp K      &kp L      &kp SEMI    &kp BSLH
&kp LSHFT  &kp Z     &kp X     &kp C       &kp V       &kp B     &to 3      &to 2       &kp N     &kp M       &kp COMMA  &kp DOT    &kp FSLH    &kp RSHFT
                               &kp LCTRL   &kp LALT    &kp LGUI  &kp SPACE  &kp RET     &kp RALT  &kp EQUAL   &kp RCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name="¯\_(ツ)_/¯";
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |  TAB  |  `  |  !  |  @   |  #   |  $   |                   |  %   |  ^    |  &    |  *   |   (   |   )   |
// |  CAPS |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |      |   ^   |   ~   |
// | SHIFT |     |     |      |      |      |   PREV |  |  NEXT |      |  _    |  +    |   <- |   v   |  ->   |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT  |  _    | CTRL  |
            bindings = <
&kp F1     &kp F2           &kp F3            &kp F4            &kp F5     &kp F6                        &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&kp TAB    &kp GRAVE        &kp EXCL          &kp AT            &kp HASH   &kp DOLLAR                    &kp PRCNT &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR
&kp CAPS   &kp EXCL         &kp AT            &kp HASH          &kp DOLLAR &kp PRCNT                     &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp UP    &kp TILDE
&kp LSHFT  &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans     &trans    &to 1      &to 3    &trans    &kp MINUS &kp PLUS  &kp LEFT  &kp DOWN  &kp RIGHT
                                              &kp LCTRL         &kp LALT   &kp LGUI  &kp SPACE  &kp RET  &kp RALT  &kp MINUS   &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        }

        raise_layer {
            display-name="Blender ᕙ(`▿´)ᕗ";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |   1   |  2   |   3   |   +   |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   4   |  5   |   6   |   -   |
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   7   |  8   |   9   |   /   |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  0   |   *   |   =   |
//                     |      |      |      |        |  |       |      |       |       |
            bindings = <
&trans    &trans &trans &trans  &trans  &trans                       &kp KP_N6   &trans    &kp KP_N1    &kp KP_N2 &kp KP_N3       &kp KP_PLUS    
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp KP_N6   &kp N7    &kp KP_N4    &kp KP_N5 &kp KP_N6       &kp KP_MINUS
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &trans      &kp LEFT  &kp KP_N7    &kp KP_N8 &kp KP_N9       &kp KP_SLASH
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &trans   &trans    &kp KP_PLUS &kp MINUS &kp KP_SLASH &kp KP_N0 &kp KP_MULTIPLY &kp EQUAL
                        &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
