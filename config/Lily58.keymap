#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        
        rgb_encoder: rgb_encoder {  
            compatible = "zmk,behavior-sensor-rotate";         
            #sensor-binding-cells = <1>;
            bindings = <&to 1>, <&to 0>;
        };
        encoder_2: encoder_2 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <1>;
            bindings = <&to 2>, <&to 1>;
        };
        gatillo_3: gatillo_3 {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <1>;
            bindings = <&to 0>, <&to 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        
        default_layer {
            display-name= "|1.|";
    // ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6  |  7  |  8   |  9   |   0   | DEL   |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y  |  U  |  I   |  O   |   P   | BSPC  |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                   |  H  |  J  |  K   |  L   |   ;   |   \   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  RAISE |  | RGB_ON|  N  |  M  |  ,   |  .   |   /   | SHIFT |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT |  =  | CTRL |
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4   &kp N5                        &kp N6    &kp N7      &kp N8     &kp N9     &kp N0      &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R    &kp T                         &kp Y     &kp U       &kp I      &kp O      &kp P       &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D     &kp F    &kp G                         &kp H     &kp J       &kp K      &kp L      &kp SEMI    &kp BSLH
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V    &kp B     &to 1     &kp C_PP  &kp N     &kp M       &kp COMMA  &kp DOT    &kp FSLH    &kp RSHFT
                               &kp LCTRL &kp LALT &kp LGUI  &kp SPACE &kp RET   &kp RALT  &kp MINUS   &kp EQUAL
            >;
 // &inc_dec_kp C_NEXT C_PREV
            sensor-bindings = <&rgb_encoder &inc_dec_kp C_NEXT C_PREV>;
        };

        lower_layer {
            display-name= "|2.|";
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |  TAB  |  `  |  !  |  @   |  #   |  $   |                   |  %   |  ^    |  &    |  *   | RGB_ON| BSPC  |
// |  CAPS |  [  |  ]  |  <   |  >   |      |                   |      |       |       |      |   ^   |       |
// | SHIFT |  (  |  )  |  /   |  \   |      |  DEFAU |  | LOWER |      |  _    |  +    |   <- |   v   |  ->   |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT  |  _    | CTRL  |
            bindings = <
&kp F1     &kp F2    &kp F3   &kp F4    &kp F5    &kp F6                                &kp F7    &kp F8    &kp F9   &kp F10   &kp F11         &kp F12
&kp TAB    &kp GRAVE &kp EXCL &kp AT    &kp HASH  &kp DOLLAR                            &kp PRCNT &kp CARET &kp AMPS &kp ASTRK &rgb_ug RGB_TOG &kp BSPC
&kp CAPS   &kp LBKT  &kp RBKT &kp LT    &kp GT    &trans                                &none     &none     &none    &none     &kp UP          &trans
&kp LSHFT  &kp LPAR  &kp RPAR &kp FSLH  &kp BSLH  &trans     &to 0     &rgb_ug RGB_TOG  &trans    &none     &none    &kp LEFT  &kp DOWN        &kp RIGHT
                              &kp LCTRL &kp LALT  &kp LGUI   &kp SPACE &kp RET &kp RALT &kp RCTRL &kp DEL
            >;

            sensor-bindings = <&encoder_2 &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
        
        adjust_layer {
            display-name= "|3.|";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  6  |  7  |  8   |  9   |  0   |                   |      |   7   |  8   |   9   |   +   |
// |  TAB  |  Y  |  U  |  I   |  O   |  P   |                   |  6   |   4   |  5   |   6   |   -   |
// |  CAPS |  H  |  J  |  K   |  L   |  ;   |                   |      |   1   |  2   |   3   |
// | SHIFT |  N  |  M  |  ,   |  .   |  /   |   PREV |  |  NEXT |  +   |   -   |  0   |   *   |   =   |
//                     | CTRL | ALT  | GUI  |  SPACE |  |       |      |       |      |
            bindings = <
&kp ESC    &kp N6    &kp N7    &kp N8     &kp N9     &kp N0                       &trans    &kp KP_N7 &kp KP_N8 &kp KP_N9       &kp KP_SLASH &kp DEL 
&kp TAB    &kp Y     &kp U     &kp I      &kp O      &kp P                        &trans    &kp KP_N4 &kp KP_N5 &kp KP_N6       &kp KP_MINUS &kp BSPC
&kp CAPS   &kp H     &kp J     &kp K      &kp L      &kp SEMI                     &trans    &kp KP_N1 &kp KP_N2 &kp KP_N3       &kp KP_SLASH &trans
&kp LSHFT  &kp N     &kp M     &kp COMMA  &kp DOT    &kp FSLH  &to 1     &to 0    &trans    &trans    &kp KP_N0 &kp KP_MULTIPLY &kp EQUAL    &trans
                               &kp LCTRL &kp RALT    &kp LGUI  &kp RET   &trans   &trans    &trans    &trans
            >;

            sensor-bindings = <&gatillo_3 &inc_dec_kp PG_UP PG_DN>;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
    };
};
