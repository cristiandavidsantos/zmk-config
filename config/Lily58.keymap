#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6  |  7  |  8   |  9   |   0   | BSPC  |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y  |  U  |  I   |  O   |   P   | DEL   |
// |  CAPS |  A  |  S  |  D   |  F   |  G   |                   |  H  |  J  |  K   |  L   |   ;   |   \   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |   PREV |  |  NEXT |  N  |  M  |  ,   |  .   |   /   | SHIFT |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT |  =  | CTRL |
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4   &kp N5                         &kp N6    &kp N7      &kp N8     &kp N9     &kp N0      &kp DEL
&kp TAB    &kp Q     &kp W     &kp E     &kp R    &kp T                          &kp Y     &kp U       &kp I      &kp O      &kp P       &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D     &kp F    &kp G                          &kp H     &kp J       &kp K      &kp L      &kp SEMI    &kp BSLH
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V    &kp B     &to 2      &to 1     &kp N     &kp M       &kp COMMA  &kp DOT    &kp FSLH    &kp RSHFT
                               &kp LCTRL &kp LALT &kp LGUI  &kp SPACE  &kp RET   &kp RALT  &kp EQUAL   &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
           // ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
// |  TAB  |  `  |  !  |  @   |  #   |  $   |                   |  %   |  ^    |  &    |  *   |   (   |   )   |
// |  CAPS |  [  |  ]  |  <   |  >   |  %   |                   |  ^   |  &    |  *    |      |   ^   |       |
// | SHIFT |  (  |  )  |  /   |  \   |      |   PREV |  |  NEXT |      |  _    |  +    |   <- |   v   |  ->   |
//                     | CTRL | ALT  | GUI  |  SPACE |  | ENTER | ALT  |  _    | CTRL  |
            bindings = <
&kp F1     &kp F2    &kp F3   &kp F4    &kp F5    &kp F6                        &kp F7    &kp F8    &kp F9            &kp F10   &kp F11          &kp F12
&kp TAB    &kp GRAVE &kp EXCL &kp AT    &kp HASH  &kp DOLLAR                    &kp PRCNT &kp CARET &kp AMPS          &kp ASTRK &ext_power EP_ON &ext_power EP_OFF
&kp CAPS   &kp LBKT  &kp RBKT &kp LT    &kp GT    &trans                        &none     &none     &ext_power EP_TOG &none     &kp UP           &trans
&kp LSHFT  &kp LPAR  &kp RPAR &kp FSLH  &kp BSLH  &trans     &to 0     &to 2    &trans    &kp MINUS &kp PLUS          &kp LEFT  &kp DOWN         &kp RIGHT
                              &kp LCTRL &kp LALT  &kp LGUI   &kp SPACE &kp RET  &kp RALT  &kp MINUS &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // ------------------------------------------------------------------------------------------------------------
// |  ESC  |  6  |  7  |  8   |  9   |  0   |                   |      |       |   1   |  2   |   3   |   +   |
// |  TAB  |  Y  |  U  |  I   |  O   |  P   |                   |  6   |   7   |   4   |  5   |   6   |   -   |
// |  CAPS |  H  |  J  |  K   |  L   |  ;   |                   |      |   <-  |   7   |  8   |   9   |   /   |
// | SHIFT |  N  |  M  |  ,   |  .   |  /   |   PREV |  |  NEXT |  +   |   -   |   =   |  0   |   *   |   =   |
//                     | CTRL | ALT  | BSPC |  SPACE |  |       |      |       |       |
            bindings = <
&kp ESC    &kp N6    &kp N7    &kp N8     &kp N9     &kp N0                       &kp KP_N6   &trans    &kp KP_N1    &kp KP_N2 &kp KP_N3       &kp KP_PLUS    
&kp TAB    &kp Y     &kp U     &kp I      &kp O      &kp P                        &kp KP_N6   &kp N7    &kp KP_N4    &kp KP_N5 &kp KP_N6       &kp KP_MINUS
&kp CAPS   &kp H     &kp J     &kp K      &kp L      &kp SEMI                       &trans      &kp LEFT  &kp KP_N7    &kp KP_N8 &kp KP_N9     &kp KP_SLASH
&kp LSHFT  &kp N     &kp M     &kp COMMA  &kp DOT    &kp FSLH  &to 1     &to 0    &kp KP_PLUS &kp MINUS &kp KP_SLASH &kp KP_N0 &kp KP_MULTIPLY &kp EQUAL
                               &kp LCTRL  &kp LALT   &kp BSPC  &kp SPACE &trans    &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };

        extra5 { status = "reserved"; };
    };
};
